{
	"name": "dna-svelte",
	"version": "0.5.0",
	"private": true,
	"description": "page for major influences to the author",
	"homepage": "https://dna.darthvid.com/",
	"repository": {
		"type": "git",
		"url": "https://github.com/tehdarthvid/dna-svelte"
	},
	"author": {
		"name": "darthvid",
		"url": "https://darthvid.com/"
	},
	"scripts": {
		"build": "vite build",
		"dev": "vite dev",
		"version": "auto-changelog -p && git add CHANGELOG.md",
		"test": "vitest run",
		"preview": "vite preview",
		"lint": "prettier --check . && eslint .",
